{
  "name": "obs-tri-cloner",
  "version": "0.1.0",
  "description": "TriCaster PRO-style broadcast control daemon for OBS Studio",
  "main": "daemon/index.js",
  "scripts": {
    "start": "node daemon/index.js",
    "dev": "node --watch daemon/index.js",
    "setup": "node setup.js",
    "check": "node setup.js --check-only",
    "install-deps": "npm install && pip3 install -r python/requirements.txt",
    "py-ctrl": "python3 python/obs_control.py"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ini": "^4.1.3",
    "inquirer": "^8.2.6",
    "node-machine-id": "^1.1.12",
    "obs-websocket-js": "^5.0.6",
    "ws": "^8.17.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "obs",
    "tricaster",
    "broadcast",
    "websocket",
    "streaming"
  ],
  "author": "OBSTriCloner",
  "license": "MIT"
}

# OBSTriCloner — Environment configuration
# Copy to .env and fill in your values

# ── OBS WebSocket ──────────────────────────────────────────────
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=your_obs_websocket_password_here

# ── Daemon ─────────────────────────────────────────────────────
DAEMON_PORT=9090

# ── TXTerp / OTV-ARPS TCP bridge ──────────────────────────────
TELETEXT_PORT=9100

# ── Input mapping (TriCaster label → OBS scene name) ──────────
INPUT_CAM1=Camera 1
INPUT_CAM2=Camera 2
INPUT_CAM3=Camera 3
INPUT_CAM4=Camera 4
INPUT_BG=Background
INPUT_BLACK=Black
INPUT_CLIP1=Clip 1
INPUT_CLIP2=Clip 2

# ── DSK (Downstream Keyer) ─────────────────────────────────────
DSK_SOURCE=DSK Overlay
DSK_FILTER=Chroma Key

# ── Audio sources (must match OBS input names exactly) ────────
AUDIO_PGM=Program Audio
AUDIO_MIC1=Microphone 1
AUDIO_MIC2=Microphone 2
AUDIO_MUSIC=Music
AUDIO_FX=Sound Effects
AUDIO_RETURN=IFB Return

# ── Transition defaults ────────────────────────────────────────
TRANSITION_NAME=Fade
TRANSITION_DURATION=500

# ── ARPS ↔ OTV bridge ──────────────────────────────────────────
# Set ARPS_ENABLED=false to disable the OTV integration entirely.
ARPS_ENABLED=true

# Host and port where OBSTriCloner is reachable FROM the OTV browser.
# OTV's obstricloner-client.js uses these to connect to /api/arps/.
ARPS_HOST=localhost
ARPS_PORT=9090

# Port that OTV's own web server runs on (used to set CORS origin).
# Set to '*' to allow any origin (default), or lock down e.g. http://localhost:3000
ARPS_OTV_PORT=*
ARPS_OTV_ORIGIN=*

# JSON map of OTV cassette/slot labels → OBS scene names.
# Example: {"Die Hard":"Movie-Scene","otv Station ID":"BrandBumper"}
ARPS_SCENE_MAP={}
